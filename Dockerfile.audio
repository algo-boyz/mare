# syntax=docker/dockerfile:1.7
FROM ubuntu:25.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    GIT_TERMINAL_PROMPT=0

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git pkg-config curl \
        libprotobuf-dev protobuf-compiler \
        libgrpc++-dev protobuf-compiler-grpc \
        libssl-dev libcurl4-openssl-dev ca-certificates \
        libportaudio2 portaudio19-dev \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
RUN rm -rf build CMakeCache.txt CMakeFiles \
    && git config --global http.version HTTP/1.1

# CMake will FetchContent sherpa-onnx (and nats, spdlog, otel, …)
# because they are not present on the system.
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_CLICKHOUSE_CONSUMER=OFF \
      -DWITH_OTEL=ON \
    && cmake --build build -j$(nproc) --target edge_audio_client

# ── runtime ──────────────────────────────────────────────
FROM ubuntu:25.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        libprotobuf32t64 libgrpc++1.51t64 libssl3 ca-certificates \
        libportaudio2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /src/build/edge_audio_client /app/

# Model directory must be present at runtime.
# Either bake it in or mount it:
#   -v ./models/sherpa-onnx-streaming-zipformer-en-2023-06-26:/app/models/...
COPY models/sherpa-onnx-streaming-zipformer-en-2023-06-26 \
     /app/models/sherpa-onnx-streaming-zipformer-en-2023-06-26

ENV LIVE_ADDR=0.0.0.0:50054 \
    INGEST_ADDR=ingest:50052 \
    SOURCE=mic \
    INGEST_FINALS=1 \
    PRINT_PARTIAL=1 \
    SHERPA_MODEL_DIR=/app/models/sherpa-onnx-streaming-zipformer-en-2023-06-26 \
    SHERPA_PROVIDER=cpu \
    SHERPA_THREADS=2

ENTRYPOINT ["/app/edge_audio_client"]