# syntax=docker/dockerfile:1.7
FROM ubuntu:25.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    GIT_TERMINAL_PROMPT=0

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git pkg-config \
        libabsl-dev \
        libprotobuf-dev protobuf-compiler \
        libgrpc++-dev protobuf-compiler-grpc \
        libssl-dev libcurl4-openssl-dev ca-certificates \
        libopencv-dev \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
RUN rm -rf build CMakeCache.txt CMakeFiles \
    && git config --global http.version HTTP/1.1

RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_CLICKHOUSE_CONSUMER=ON \
      -DBUILD_VIDEO_SERVER=ON \
      -DWITH_OTEL=ON \
    && cmake --build build -j$(nproc) --target video_server

# ── runtime ──────────────────────────────────────────────
FROM ubuntu:25.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        libprotobuf32t64 libgrpc++1.51t64 libssl3 ca-certificates \
        libabsl20230802 \
        libopencv-core410 libopencv-imgproc410 \
        libopencv-imgcodecs410 libopencv-videoio410 \
        libopencv-highgui410 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /src/build/video_server /app/
COPY assets /app/assets

CMD ["/app/video_server"]